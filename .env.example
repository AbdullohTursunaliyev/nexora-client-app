# Nexora mobile env template — copy to `.env` and adjust.
# `EXPO_PUBLIC_*` values are embedded in the JS bundle at build time;
# they are NOT secrets — but the API URL still needs to point at the right
# environment.

# Local development (replace 192.168.x.x with your computer's Wi-Fi LAN IP).
# Phone and computer must share the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.0.154:8080/api

# Production example (set via EAS Build secrets, not committed):
# EXPO_PUBLIC_API_URL=https://api.nexora.uz/api
#
# Production builds REJECT non-https:// URLs at startup — see
# lib/api/config.ts.
